PORT=8080
ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_USER=cooked
DB_PASS=cooked
DB_NAME=cooked
DB_SSL_MODE=disable

JWT_ACCESS_SECRET=dev-jwt-secret-change-me
JWT_REFRESH_SECRET=dev-jwt-refresh-change-me
# JWT_SECRET can stand in for both secrets above during a transition.
JWT_ACCESS_TTL=15
JWT_REFRESH_TTL=14
JWT_EMAIL_VERIFY_TTL=24
# Comma-separated proxy CIDRs. Unset = trust no proxies (use the remote address).
# TRUSTED_PROXIES=10.0.0.0/8
ALLOWED_ORIGINS=http://localhost:3000

# Google OAuth is optional. All four values are required to enable it.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback
# GOOGLE_OAUTH_ALLOWED_RETURN_URLS=http://localhost:3000/auth/callback


# Brevo is optional. Leave these unset to boot the API without email delivery.
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=noreply@yourdomain.com
# BREVO_SENDER_NAME=Cooked
# NOTIFY_CHANNELS=in_app,email
#INSTRUMENT_ENCRYPTION_KEY=...   # optional; defaults from JWT secret in dev
#OPS_ADMIN_EMAILS=ops@example.com
#674577793346-rnjjvgu0srjfmur5rte7fp1vc7f20jt1.apps.googleusercontent.com



# Brevo transactional email (https://app.brevo.com)
BREVO_BASE_URL=https://api.brevo.com/v3
 BREVO_API_KEY=
 BREVO_SENDER_EMAIL=wizzywizpad@gmail.com
 BREVO_SENDER_NAME=wizzywizpad@gmail.com

# S3-compatible media storage (MinIO, AWS S3, Cloudflare R2, etc.)
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=cooked-media
S3_REGION=us-east-1
S3_USE_SSL=false

# Durable background worker
WORKER_ID=cooked-worker-local
WORKER_POLL_INTERVAL_MS=1000
WORKER_BATCH_SIZE=20

# Cook Mode rewards and abuse caps
COOK_BASE_XP=50
COOK_PHOTO_XP=10
COOK_FIRST_DISH_XP=25
COOK_DAILY_REWARDED_SESSIONS=5
# NOTIFY_CHANNELS=in_app,email
#INSTRUMENT_ENCRYPTION_KEY=...   # optional; defaults from JWT secret in dev
#OPS_ADMIN_EMAILS=ops@example.com
